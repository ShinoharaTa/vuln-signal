# 環境変数の一覧（例示用）。
# 実体は ~/.config/vuln-signal/env（chmod 600）に置き、systemd の EnvironmentFile= で読む。
# このファイルに値を書かない。

# NVD API キー。発行: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
# GitHub の fine-grained トークン（権限なし）。GHSA 取得と検索用
GITHUB_TOKEN=

# Gemini API キー（課金を有効にしたキー）
GEMINI_API_KEY=
# 使うモデル名（秘密ではない）
GEMINI_MODEL_LITE=gemini-3.1-flash-lite
GEMINI_MODEL=gemini-3.8-flash
# 1 回の実行で使う LLM トークンの上限
LLM_TOKEN_BUDGET_PER_RUN=

# Cloudflare のアカウント ID
CLOUDFLARE_ACCOUNT_ID=
# Cloudflare の API トークン（D1 の編集権限のみ）
CLOUDFLARE_API_TOKEN=
# D1 データベースの ID
D1_DATABASE_ID=

# Discord の Webhook URL（配信先チャンネルで発行）
DISCORD_WEBHOOK_URL=

# メール送信: 送信サービス未定（docs/design.md §9.6）
